LOG_LEVEL=INFO
API_PORT=8000
REPORTS_DIR=reports
# 工作台导出底稿目录（默认=项目根；可改为绝对路径）
# WORKBOOK_OUTPUT_DIR=
# 任务 JSON 落盘（默认开；与 CUTOFF_JOB_ROOT/{job_id}/job_state.json）
AUDIT_JOB_PERSIST=1
# CUTOFF_JOB_ROOT=D:/Dev/Temp/cutoff_jobs
# 会计日历：natural_month | fiscal_445 | period_end_only
# AUDIT_CALENDAR_MODE=natural_month
# AUDIT_FISCAL_YEAR_START=2025-01-01
WORKBOOK_FILENAME=底稿_GOSPD01010.csv
# 上传/OCR 中间文件目录（与底稿输出分离）
# CUTOFF_JOB_ROOT=D:/Dev/Temp/cutoff_jobs
QIANFAN_API_KEY=your_api_key
QIANFAN_SECRET_KEY=your_secret_key
QIANFAN_ACCESS_KEY=your_access_key
QIANFAN_OCR_MODEL=pp-structurev3
LLM_API_URL=https://qianfan.baidubce.com/v2/chat/completions
LLM_API_KEY=
LLM_MODEL=ernie-4.5-turbo-128k
# 千帆视觉金额歧义预判断（留空 Key 时回退 LLM_API_KEY / QIANFAN_API_KEY）
QIANFAN_VISION_ENABLED=1
QIANFAN_VISION_API_URL=https://qianfan.baidubce.com/v2/chat/completions
QIANFAN_VISION_API_KEY=
QIANFAN_VISION_MODEL=ernie-4.5-turbo-vl
QIANFAN_VISION_TIMEOUT_SECONDS=60
QIANFAN_VISION_MAX_IMAGE_BYTES=9500000
# 金额歧义自动增强（1=开）：增值税发票专精 + 千帆视觉；均不自动写字段
AMOUNT_AMBIGUITY_AUTO_VAT=1
AMOUNT_AMBIGUITY_AUTO_VISION=1
# 上传 OCR 过程中同步增强（默认 0，避免拖慢主路径；字段页扫描时会增强）
AMOUNT_AMBIGUITY_ENRICH_ON_PROCESS=1
# 可选：百度文字识别 OCR 专用 AK/SK（增值税发票识别）。留空则回退 QIANFAN_ACCESS_KEY/SECRET
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
FIELD_EXTRACT_MODE=llm_first
BATCH_LLM_ASSIST=1
CONCLUSION_LLM_ASSIST=1
CONCLUSION_LLM_ON_PASS=0
MATCHING_LLM_DISAMBIGUATION=1
# HITL API 门禁：auto=禁 OCR Mock 时自动开启；0=批测关闭；1=强制开
REQUIRE_FIELDS_CONFIRMED_API=auto
REQUIRE_MATCHING_CONFIRMED_API=auto
REQUIRE_CONCLUSION_CONFIRMED_API=auto
# 正式审计：保持 0，禁止 OCR 失败时写入 Mock 虚构字段；演示可设 1
AUDIT_ALLOW_OCR_MOCK=0
# 六笔演示样例按文件名回放已识别结果（进度条仍走，但很快）。正式任务可设 0
DEMO_OCR_CACHE=1
# 混装拆包：低质量窗口相邻页视觉边界，每文件最多调用次数（0=禁用视觉边界）
PACKET_VLM_MAX_CALLS_PER_FILE=12
# OCR 前 L1 几何预处理（1=开；白页直通，灰/手持页 deskew+warp）。0=关
AUDIT_IMAGE_PREPROCESS=1
# 可选 Paddle 方向模型（纯英文路径）；不配则跳过方向仅做 deskew/warp
# AUDIT_ORIENTATION_MODEL_ROOT=D:/AuditImageLabRuntime/paddle-models
# AUDIT_ORIENTATION_WORKER_PYTHON=D:/AuditImageLabRuntime/paddle-orientation-venv/Scripts/python.exe
# AUDIT_IMAGE_PREPROCESS_RUNTIME=D:/AuditImageLabRuntime/preprocess-runtime
# 开启 REQUIRE_*_API 时，默认须传 job_id 由服务端校验确认态；仅旧脚本自证 Header 时才开 1
HITL_TRUST_CLIENT_HEADER=0
ENABLE_RELATION_CANDIDATES=1
ENABLE_DUPLICATE_DETECTION=1
HITL_OPERATOR=
# 贸易模式判断（名义≠实际）。默认关 LLM；开 1 时 DeepSeek 仅 advisory，不得写底稿三键
TRADING_MODEL_LIVE_LLM=0
CONTRACT_RAG_EMBEDDER=hash
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
